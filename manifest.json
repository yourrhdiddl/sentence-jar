{
  "manifest_version": 3,
  "name": "My Sentences",
  "version": "1.0.0",
  "description": "Save sentences you love from any web page with one right-click.",
  "permissions": ["contextMenus", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "My Sentences",
    "default_popup": "popup.html"
  }
}
